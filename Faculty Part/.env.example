# LLM
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:12b
OLLAMA_BASE_URL=http://localhost:11434
# GEMINI_API_KEY=

# Embeddings and reranker
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
FACULTY_COLLECTION_NAME=faculty_chunks
STUDENT_COLLECTION_NAME=academic_rag

# OCR (optional)
TESSERACT_PATH=

# Application
DEBUG=False
LOG_LEVEL=INFO

# Sign-in accounts
# Format: email:bcrypt_hash:role:name   (role = student | faculty | admin)
# Hash:   python -c "import bcrypt; print(bcrypt.hashpw(b'password', bcrypt.gensalt()).decode())"
DEMO_USER_STUDENT=
DEMO_USER_FACULTY=
DEMO_USER_ADMIN=
